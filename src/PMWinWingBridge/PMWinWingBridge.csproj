<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PMWinWingBridge</AssemblyName>
    <RootNamespace>PMWinWingBridge</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Robert Kossakowski</Authors>
    <Copyright>Copyright © 2026 Robert Kossakowski</Copyright>
    <Description>Bridge between Project Magenta CDU software and WinWing CDU hardware.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="mcdu-dotnet" Version="1.4.0" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="bridge-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
